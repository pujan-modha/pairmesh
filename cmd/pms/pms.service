[Unit]
Description=pairmesh server (derper + Caddy + bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pms run --config /etc/pms/config.yaml
Restart=always
RestartSec=2
TimeoutStopSec=25
# :80/:443/public-port binds need privilege: keep an unprivileged dynamic
# user and grant only the bind capability (inherited by caddy/derper).
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=pms
ConfigurationDirectory=pms
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
